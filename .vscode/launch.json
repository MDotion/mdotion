{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Mdotion)",
      "type": "extensionHost",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
